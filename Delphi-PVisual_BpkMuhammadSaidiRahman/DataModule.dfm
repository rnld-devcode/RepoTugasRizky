  object FDQueryJadwalPerkuliahan: TFDQuery
    Active = True
    Connection = FDConnectionUniska
    SQL.Strings = (
      ''
      ''
      'SELECT jadwal.*, mata_kuliah.nama_mk, dosen.nama_dosen FROM'
      
        'jadwal INNER JOIN mata_kuliah ON jadwal.matkul_id = mata_kuliah.' +
        'id INNER'
      'JOIN dosen ON jadwal.dosen_id = dosen.id')
